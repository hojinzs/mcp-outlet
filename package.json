{
  "name": "mcp-outlet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mcp-outlet/gateway --filter @mcp-outlet/web dev",
    "dev:runner": "pnpm --filter @mcp-outlet/runner dev",
    "build": "pnpm --filter @mcp-outlet/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
