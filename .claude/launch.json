{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--parallel",
        "--filter",
        "@mcp-outlet/gateway",
        "--filter",
        "@mcp-outlet/runner",
        "dev"
