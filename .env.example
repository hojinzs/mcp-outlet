# cp .env.example .env 후 값을 채운다. compose는 DATABASE_URL·RUNNER_URL을 덮어쓴다.

# --- Postgres (compose) ---
POSTGRES_USER=outlet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outlet

# --- gateway ---
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://outlet:change-me@localhost:5432/outlet
LOG_LEVEL=info

# OIDC IdP (표준 OIDC면 어느 것이든 가능)
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/mcp-outlet/.well-known/openid-configuration
OIDC_CLIENT_ID=mcp-outlet
# Public client(PKCE)면 비워 둔다
OIDC_CLIENT_SECRET=
OIDC_GROUPS_CLAIM=groups
# 쉼표로 구분. 비우면 IdP 로그인에 성공한 모든 사용자 허용
OIDC_LOGIN_GROUPS=
OIDC_ADMIN_GROUPS=mcp-outlet-admins

# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# 키 회전 중에만 이전 키를 넣는다
ENCRYPTION_KEY_PREVIOUS=

# --- gateway ↔ runner (stdio 런타임, v2) ---
# v1은 비워 둔다. 켤 때는 compose.stdio.yaml을 겹치거나 로컬에서 pnpm dev:runner를 띄운다
RUNNER_URL=
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUNNER_TOKEN=
