# cp .env.example .env 후 값을 채운다. compose는 DATABASE_URL·RUNNER_URL을 덮어쓴다.

# --- Postgres (compose) ---
POSTGRES_USER=outlet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outlet

# --- gateway ---
# 로컬 pnpm dev는 http://localhost:5173 (Vite가 gateway로 넘긴다), compose는 http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://outlet:change-me@localhost:5432/outlet
LOG_LEVEL=info
# 리버스 프록시(Coolify 등) 뒤에 둘 때 true
TRUST_PROXY=false

# OIDC IdP (표준 OIDC면 어느 것이든 가능)
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/mcp-outlet/.well-known/openid-configuration
OIDC_CLIENT_ID=mcp-outlet
# Public client(PKCE)면 비워 둔다
OIDC_CLIENT_SECRET=
# MCP 요청 토큰의 aud. 비우면 OIDC_CLIENT_ID
OIDC_AUDIENCE=
# 공백으로 구분. groups를 별도 scope로 주는 IdP는 여기에 더한다 (MCP 클라이언트에도 같은 scope를 알린다)
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=groups
# 쉼표로 구분. 비우면 IdP 로그인에 성공한 모든 사용자 허용
OIDC_LOGIN_GROUPS=
OIDC_ADMIN_GROUPS=mcp-outlet-admins

# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# 키 회전 중에만 이전 키를 넣는다
ENCRYPTION_KEY_PREVIOUS=
# 로그인 중 state·PKCE 쿠키 서명. 32자 이상
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 관리 UI 세션 수명(시간). 로그인 시점부터 센다
SESSION_TTL_HOURS=12

# 사용자 원격 URL의 사설 주소 차단 예외(CIDR, 쉼표 구분). 이 대역은 http도 허용한다. 운영에서는 비워 둔다
# 로컬에서 테스트용 MCP 서버를 붙일 때 예: 127.0.0.1/32
UPSTREAM_ALLOW_CIDRS=
UPSTREAM_TIMEOUT_MS=30000

# 사용자당 커넥터·엔드포인트 상한
MAX_CONNECTORS_PER_USER=20
MAX_ENDPOINTS_PER_USER=50

# 보관 기간(일). 0이면 지우지 않는다
AUDIT_RETENTION_DAYS=90
ACTIVITY_RETENTION_DAYS=365

# --- gateway ↔ runner (stdio 런타임, v2) ---
# v1은 비워 둔다. 켤 때는 compose.stdio.yaml을 겹치거나 로컬에서 pnpm dev:runner를 띄운다
RUNNER_URL=
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUNNER_TOKEN=
